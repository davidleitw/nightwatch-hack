{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NightWatch hackathon initial state — dynamic graph profile",
  "description": "Uses the existing full state contract and incident read model. The UI targets 8–12 nodes without a fixed count or ID allowlist. Backend must keep capabilities.nodes and graph_now.nodes consistent. No live log history is included.",
  "allOf": [
    {
      "$ref": "../../contracts/schemas/state.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "graph_now": {
          "$ref": "graph.schema.json"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "nodes"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "layout"
                ],
                "properties": {
                  "id": {
                    "$ref": "graph.schema.json#/$defs/nodeId"
                  },
                  "kind": {
                    "$ref": "../../contracts/schemas/node.schema.json#/properties/kind"
                  },
                  "layout": {
                    "type": "object",
                    "required": [
                      "row",
                      "col"
                    ],
                    "properties": {
                      "row": {
                        "type": "integer"
                      },
                      "col": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
